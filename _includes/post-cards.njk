<div class="cards-container">
  {% for post in postList %} {% if post.data.title != blank %}
  <div class="post-card">
    <div class="card-date">{{ post.date | dateformat }}</div>
    <div class="card-title">
      <a href=".{{ post.url }}">{{ post.data.title }} </a>
    </div>

    <div class="categories">
      <!-- Update tagsList -->
      {% if post.data.tags %} {% set tagsList = post.data.tags %}
      <!-- Show tags -->
      {% for tag in tagsList %}
      <div class="card-tag">
        <a href="./archive/?tag={{tag}}"> #{{ tag }}</a>
      </div>
      {% endfor %} {% endif %}
    </div>
    {# 摘要为空时不渲染这一块。以前渲染出一个空的 .card-summary，它自己的
       margin-bottom: 32px 会在标签和 Read more 之间留一段说不清来历的空白。 #}
    {% set summary = post.content | abstract %} {% if summary %}
    <div class="card-summary">{{ summary }}</div>
    {% endif %}
    <a href=".{{ post.url }}" class="read-more-btn">Read more</a>
  </div>
  {% endif %} {% endfor %}
</div>
